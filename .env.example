NEXT_PUBLIC_SUPABASE_URL=
# Optional local-development browser URL. Use /_supabase when a remote dev
# preview cannot reach the server-only Supabase address directly. Ignored in
# production by the Next.js proxy.
NEXT_PUBLIC_SUPABASE_BROWSER_URL=
# Required with a relative browser URL so browser, middleware, and server share
# one stable Supabase session cookie across dynamically forwarded ports.
NEXT_PUBLIC_SUPABASE_COOKIE_NAME=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=

# Feeds v1 (server-only). Production must use HTTPS and an isolated Miniflux
# fetch network that blocks private, loopback, link-local, and metadata CIDRs
# on DNS resolution and every redirect hop.
MINIFLUX_BASE_URL=
MINIFLUX_EGRESS_HARDENED=false
# When true, account approval and the Feeds connection endpoint ensure one
# non-admin Miniflux user and API key per Reporting auth user.
MINIFLUX_AUTO_PROVISION=false
# Prefer a mounted 0600 file. The direct value is supported for secret-manager
# injected environments. Never expose either value with a NEXT_PUBLIC_ prefix.
MINIFLUX_PROVISIONER_TOKEN_FILE=
MINIFLUX_PROVISIONER_TOKEN=
# Curated Explore uses one deployment-wide non-admin Miniflux user at the same
# MINIFLUX_BASE_URL. Prefer the mounted 0600 token file in deployed environments.
MINIFLUX_EXPLORE_TOKEN_FILE=
MINIFLUX_EXPLORE_TOKEN=
# Mandatory non-secret identity binding for the deployment-wide collector.
# The setup script prints this value after verifying reporting_explore.
MINIFLUX_EXPLORE_USER_ID=
# Local development only; ignored in production.
MINIFLUX_ALLOW_INSECURE_HTTP=false

# Federated Search (server-only). Point this at an operator-supervised SearXNG
# instance; devctl probes it but never creates or stops its container. Never
# expose the endpoint or its credentials to the browser.
REPORTING_SEARXNG_URL=http://127.0.0.1:8086
REPORTING_SEARXNG_PORT=8086
# Generate with: openssl rand -hex 32
REPORTING_SEARXNG_SECRET=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# If using Fathom Analytics for site tracking
NEXT_PUBLIC_FATHOM_SITE_ID=

# If using Resend for Supabase Auth or email sending
RESEND_API_KEY=
CONTACT_EMAIL=                           
CONTACT_FROM=

# If using due diligence or other scheduled background work. Generate a strong,
# server-only value with `openssl rand -hex 32`; Web and Cron processes must use
# the same value.
CRON_SECRET=
# Separate signing key for short-lived, attempt-scoped background Job Tokens.
# Generate at least 32 random bytes; never reuse CRON_SECRET or expose this to
# browser code. Web processes that issue and verify tokens use the same value.
BACKGROUND_JOB_TOKEN_SECRET=
# Exact server-only origin used for Dispatcher → Worker and Worker → Search
# calls. Never derive this from Host/X-Forwarded headers or NEXT_PUBLIC values.
BACKGROUND_JOB_INTERNAL_ORIGIN=
# Origin of the persistent Next.js Web process called by the separate Cron
# process. Production requires HTTPS unless an explicitly trusted private
# network needs CRON_RUNNER_ALLOW_INSECURE_HTTP=true.
CRON_RUNNER_BASE_URL=
# Minimal Cron process liveness/readiness listener.
CRON_RUNNER_HEALTH_HOST=0.0.0.0
CRON_RUNNER_HEALTH_PORT=3101
# Optional global request timeout override; blank uses the bounded per-job
# values in scripts/cron-runner/config.mjs.
CRON_RUNNER_REQUEST_TIMEOUT_MS=
CRON_RUNNER_SHUTDOWN_GRACE_MS=30000
CRON_RUNNER_ALLOW_INSECURE_HTTP=false

# Set to "true" to seed demo data and disable email parsing
# DEMO_MODE=true

# Diligence call transcription (Deepgram). Optional unless you upload
# audio/video recordings; missing keys only break that one flow.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# Shared secret carried in the webhook URL path. Generate with
# `openssl rand -hex 32` and keep it secret — anyone with it can post
# transcripts. Must match between the worker and the webhook route.
# TRANSCRIPTION_WEBHOOK_SECRET=
# Optional override for the webhook base URL (set when a dev tunnel like
# ngrok is needed). Falls back to NEXT_PUBLIC_SITE_URL / VERCEL_URL.
# TRANSCRIPTION_WEBHOOK_URL=

# Heartbeat community integration (new threads in a watched channel -> Deals).
# The API key itself is NOT set here — an admin enters it in Settings and it is
# stored encrypted per fund. This is only an optional override for the base URL
# that Heartbeat's THREAD_CREATE webhook is pointed at (set when a dev tunnel
# like ngrok is needed). Falls back to NEXT_PUBLIC_SITE_URL / VERCEL_URL.
# Without a public base URL, channels are still watched — the hourly backfill
# poll picks their threads up — but no webhook is registered.
# HEARTBEAT_WEBHOOK_URL=
